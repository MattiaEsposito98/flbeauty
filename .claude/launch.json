{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "D:/xampp/php/php.exe",
      "runtimeArgs": [
        "-d", "xdebug.mode=off",
        "-d", "zend_extension=opcache",
        "-d", "opcache.enable=1",
        "-d", "opcache.enable_cli=1",
        "-d", "opcache.memory_consumption=128",
        "-d", "opcache.revalidate_freq=0",
        "-S", "127.0.0.1:8000",
        "-t", "backend/public",
        "tools/dev-server.php"
      ],
      "port": 8000
    }
  ]
}
