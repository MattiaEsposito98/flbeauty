# Esempio di .env per la PRODUZIONE (admin.flbeauty.it su Aruba).
# Copia in .env sul server e compila i campi marcati con <...>. Non committare mai il .env vero.

APP_NAME=FLBeauty
APP_ENV=production
APP_KEY=                       # genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://admin.flbeauty.it
FRONTEND_URL=https://flbeauty.it
ADMIN_ORDER_EMAIL=flbeauty32@gmail.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database MySQL creato dal pannello Aruba
DB_CONNECTION=mysql
DB_HOST=<host del database indicato da Aruba>
DB_PORT=3306
DB_DATABASE=<nome database>
DB_USERNAME=<utente database>
DB_PASSWORD=<password database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Solo il negozio può chiamare le API dal browser
CORS_ALLOWED_ORIGINS=https://flbeauty.it

# Dove scrivere sitemap.xml: la cartella pubblica del negozio (flbeauty.it)
SITEMAP_PATH=<percorso assoluto>/sitemap.xml

# Email (Brevo, vedi docs/EMAIL.md)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<login SMTP Brevo>
MAIL_PASSWORD=<chiave SMTP Brevo>
MAIL_FROM_ADDRESS="no-reply@flbeauty.it"
MAIL_FROM_NAME="${APP_NAME}"
