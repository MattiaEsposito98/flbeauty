# Esempio di .env per la PRODUZIONE (tutto su flbeauty.it: negozio, /api e /admin).
# Copia in .env sul server e compila i campi marcati con <...>. Non committare mai il .env vero.

APP_NAME=FLBeauty
APP_ENV=production
APP_KEY=                       # genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://www.flbeauty.it
FRONTEND_URL=https://www.flbeauty.it
ADMIN_ORDER_EMAIL=info@flbeauty.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database MySQL creato dal pannello Aruba
DB_CONNECTION=mysql
DB_HOST=<host del database indicato da Aruba>
DB_PORT=3306
DB_DATABASE=<nome database>
DB_USERNAME=<utente database>
DB_PASSWORD=<password database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
QUEUE_CONNECTION=deferred
CACHE_STORE=database
FILESYSTEM_DISK=local

# Negozio e API sono sullo stesso indirizzo; resta per sicurezza
CORS_ALLOWED_ORIGINS=https://www.flbeauty.it

# Dove scrivere sitemap.xml: la cartella pubblica www.flbeauty.it
SITEMAP_PATH=<percorso assoluto dello spazio web>/www.flbeauty.it/sitemap.xml

# Email (Brevo, vedi docs/EMAIL.md)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtps.aruba.it
MAIL_PORT=465
MAIL_USERNAME=info@flbeauty.it
MAIL_PASSWORD=<password della casella info@, la inserisci tu sul server>
MAIL_FROM_ADDRESS="info@flbeauty.it"
# Mittente delle email automatiche (verifica account, reset, comunicazioni): alias no-reply di info@.
# Decommentare solo DOPO aver creato l'alias in Aruba (Webmail → Alias), altrimenti Aruba rifiuta l'invio.
# MAIL_NOREPLY_ADDRESS="no-reply@flbeauty.it"
MAIL_FROM_NAME="F&L Beauty"
