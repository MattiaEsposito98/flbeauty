# Esempio per la build di PRODUZIONE del negozio (flbeauty.it).
# Copia in `.env.production` (non committare) e lancia `npm run build`: i valori
# vengono scritti nei file della cartella dist/.

VITE_API_URL=https://flbeauty.it/api
VITE_SITE_URL=https://flbeauty.it

# ID di Google Analytics 4 (G-XXXXXXXXXX). Lasciare vuoto finché non lo hai creato:
# senza ID non compare il banner cookie e Analytics non viene caricato.
VITE_GA_MEASUREMENT_ID=
